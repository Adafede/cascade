{
  "@context": "https://doi.org/10.5063/schema/codemeta-2.0",
  "@type": "SoftwareSourceCode",
  "identifier": "cascade",
  "description": "Provides the infrastructure to perform Automated Composition Assessment of Natural Extracts by combining untargeted mass spectrometry feature tables and taxonomically informed metabolite annotations (TIMA) with semi-quantitative universal detectors such as Charged Aerosol Detection (CAD) and Photodiode Array (PDA) chromatograms. Includes Fourier filtering, derivative-based peak sharpening, peak integration, extracted ion chromatogram correlation, Wikidata/LOTUS chemotaxonomic literature queries, and interactive visualizations.",
  "name": "cascade: Contextualizing Untargeted Annotation with Semi-Quantitative Charged Aerosol Detection for Pertinent Characterization of Natural Extracts",
